NUXT_PUBLIC_API_BASE=http://localhost:3000/api/v1
NUXT_PUBLIC_APP_URLS_CUSTOMER=http://localhost:3001
NUXT_PUBLIC_APP_URLS_WORKER=http://localhost:3002
NUXT_PUBLIC_APP_URLS_ADMIN=http://localhost:3003
# Map tiles. OpenStreetMap's own servers (the default) are for development only.
# Production: NUXT_PUBLIC_MAP_PROVIDER=maptiler and a MapTiler key restricted to our domains.
NUXT_PUBLIC_MAP_PROVIDER=osm
NUXT_PUBLIC_MAPTILER_KEY=
NUXT_PUBLIC_MAPTILER_STYLE=streets-v4
