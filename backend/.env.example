DB_HOST=localhost
DB_PORT=5433
REDIS_URL=redis://localhost:6380
# Comma-separated origins allowed by CORS
APP_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# HMAC secrets (generate with: bin/rails secret)
JWT_SECRET=change-me
OTP_PEPPER=change-me
# sms adapter: fake | msg91 | twilio
SMS_ADAPTER=fake
# Refresh cookie domain in production (.workerly.in)
COOKIE_DOMAIN=
TOKEN_PEPPER=change-me
# Active Record encryption (generate with: bin/rails db:encryption:init)
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
