DB_HOST=localhost
DB_PORT=5433
REDIS_URL=redis://localhost:6380
# Comma-separated origins allowed by CORS
APP_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# HMAC secrets (generate with: bin/rails secret)
JWT_SECRET=change-me
OTP_PEPPER=change-me
# sms adapter: fake | msg91 | twilio
SMS_ADAPTER=fake
# Refresh cookie domain in production (.workerly.in)
COOKIE_DOMAIN=
TOKEN_PEPPER=change-me
# Active Record encryption (generate with: bin/rails db:encryption:init)
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
# AI triage (Phase 3). AI_ADAPTER: fake (keyword rules, no network) | openai
AI_TRIAGE_ENABLED=true
AI_ADAPTER=fake
OPENAI_API_KEY=
# Required when AI_ADAPTER=openai, e.g. a small vision-capable model
AI_TRIAGE_MODEL=
AI_USER_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=5000
# How long a submitted request stays open for quotes (decision D5)
REQUEST_TTL_HOURS=24
# Matching (decision D5 pending; plan defaults)
MATCH_FANOUT=10
MAX_QUOTES_PER_REQUEST=5
LEAD_SMS_FALLBACK=true
# Web push: generate with bin/rails webpush:keys. Leave empty to disable push (SMS fallback still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@workerly.in
# Public WebSocket URL handed to the apps with each cable ticket
ACTION_CABLE_URL=ws://localhost:3000/cable

# Payments (Phase 7). PAYMENT_ADAPTER=razorpay needs the keys below (test-mode keys for staging).
PAYMENT_ADAPTER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
INVOICE_PREFIX=WK
INSPECTION_FEE_ADJUSTED=true
BOOKING_CONTACT_HOURS=48
REVIEW_WINDOW_DAYS=30
DISPUTE_WINDOW_DAYS=7
