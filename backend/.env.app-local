# Local production-like stack only (docker compose --profile app). Not secrets: fixed local values.
RAILS_ENV=production
DEPLOY_ENV=staging
FORCE_SSL=false
LOCAL_DISK_STORAGE=1
RAILS_LOG_LEVEL=info
DATABASE_URL=postgis://workerly:workerly@db:5432/workerly_app_local
REDIS_URL=redis://redis:6379
APP_HOSTS=localhost
APP_ORIGINS=http://localhost:3101,http://localhost:3102,http://localhost:3103
ACTION_CABLE_URL=ws://localhost:3100/cable
SECRET_KEY_BASE=local-app-stack-secret-key-base-not-for-real-use-0000000000000000000000000000
JWT_SECRET=local-app-stack-jwt
OTP_PEPPER=local-app-stack-otp
TOKEN_PEPPER=local-app-stack-token
RAZORPAY_KEY_SECRET=local
RAZORPAY_WEBHOOK_SECRET=local
AR_ENCRYPTION_PRIMARY_KEY=local-app-stack-primary-key-00000
AR_ENCRYPTION_DETERMINISTIC_KEY=local-app-stack-deterministic-000
AR_ENCRYPTION_KEY_DERIVATION_SALT=local-app-stack-salt-000000000000
SMS_ADAPTER=fake
PAYMENT_ADAPTER=fake
AI_ADAPTER=fake
AI_TRIAGE_ENABLED=true
AI_TRANSCRIBE_ENABLED=true
